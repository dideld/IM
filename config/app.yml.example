# GinChat 配置模板 —— 复制为 app.yml 后填入真实值
# 所有环境变量可通过 AUTOMAXPROCS / MYSQL_DNS / REDIS_ADDR 等覆盖（点号→下划线）

app: GinChat

# ---- 服务端口 ----
port:
  server: ":8080"
  udp: 3001

# ---- MySQL ----
mysql:
  dns: "root:YOUR_PASSWORD@tcp(host.docker.internal:3306)/ginchat?charset=utf8mb4&parseTime=True&loc=Local"

# ---- Redis ----
redis:
  addr: "host.docker.internal:6379"
  password: ""
  DB: 0
  poolSize: 10
  minIdleConn: 5

# ---- Kafka ----
kafka:
  broker: "host.docker.internal:9092"
  topic: "chat_messages"
  consumerGroup: "chat_redis_saver_group"
  partitions: 1    # 仅影响 topic 首次创建；扩分区前确认 Produce Key=convId 已生效（同会话同分区=seq 单写者前提）

# ---- 雪花算法 ----
snowflake:
  workerId: 1   # 0~31，多实例必须逐实例配置不同值

# ---- 心跳超时 ----
timeout:
  DelayHeartbeat: 60   # 秒

# ---- 冷热存储 ----
storage:
  coldMode: "batch"      # batch | inline(=unit 1 的低延迟特例，同一代码路径)
  coldBatchSize: 100
  coldFlushMs: 50
  aggregateWindowMs: 2   # 消费聚合窗口：攒批合并门禁/发号/落地 Pipeline（inline 档自动为 0）
  aggregateMax: 500      # 单聚合窗口最大消息数
  hotKeep: 200           # 热层单会话保留条数
  hotTTLDays: 7
  skipBenchPersist: false

# ---- 离线推送（挂点，厂商实现未接）----
push:
  enabled: false
  debug: false
  groupPushMaxMembers: 200   # 大群阈值：成员数超过即走 Type=7 合并帧 + seq−游标 计算式未读

# ---- 会话鉴权 ----
auth:
  devSkipWSToken: false  # 压测专用，生产严禁开启

# ---- 上传 ----
upload:
  path: "./asset/upload"
  maxSizeMB: 10

# ---- Hub ----
hub:
  maxDevices: 5          # 单用户最大在线设备数
