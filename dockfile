# 阶段 1: 编译环境
FROM golang:1.21-alpine AS builder

# 设置工作目录
WORKDIR /app

# 设置代理（国内服务器构建必选，否则拉不动包）
ENV GOPROXY=https://goproxy.cn,direct

# 先复制 mod 文件，利用 Docker 缓存层优化构建速度
COPY go.mod go.sum ./
RUN go mod download

# 复制源码和配置文件
COPY . .

# 编译成可执行文件 (命名为 main)
RUN CGO_ENABLED=0 GOOS=linux go build -o main .

# 阶段 2: 运行环境 (使用极小的 alpine 镜像)
FROM alpine:latest

WORKDIR /app

# 从编译阶段拷贝二进制文件和配置文件
COPY --from:builder /app/main .
COPY --from:builder /app/config.yaml . 

# 暴露 Gin 默认端口（假设你在 app.yml 配置的是 8080）
EXPOSE 8080

# 启动程序
CMD ["./main"]