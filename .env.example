# 一键全栈（docker-compose）所需的本地变量示例：复制为 .env 后按需修改（.env 已 gitignore）
#   copy .env.example .env        (Windows)  /  cp .env.example .env  (Linux/macOS)
# 仅开发默认值；生产务必改密码。宿主机直跑 go run . 不走 compose，用同名 env 注入即可覆盖 yml（viper AutomaticEnv）。
MYSQL_ROOT_PASSWORD=111111
MYSQL_DNS=root:111111@tcp(mysql:3306)/ginchat?charset=utf8mb4&parseTime=True&loc=Local
