                "summary": "读取冷层历史消息（MySQL，游标分页）",
                "parameters": [
                    {
                        "type": "string",
                        "description": "会话ID",
                        "name": "convId",
                        "in": "formData"
                    },
                    {
                        "type": "integer",
                        "description": "私聊用户A的ID（无convId时使用）",
                        "name": "userIdA",
                        "in": "formData"
                    },
                    {
                        "type": "integer",
                        "description": "私聊用户B的ID（无convId时使用）",
                        "name": "userIdB",
                        "in": "formData"
                    },
                    {
                        "type": "integer",
                        "description": "游标：只取 seq 小于该值的消息，0=从最新开始",
                        "name": "beforeSeq",
                        "in": "formData"
                    },
                    {
                        "type": "integer",
                        "description": "条数，默认20，最大100",
                        "name": "size",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/utils.Response"
                        }
                    }
                }
            }
        },
